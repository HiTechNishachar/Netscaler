nsdiff() {
    echo -e "\n=== SAVED vs RUNNING CONFIG DIFFERENCE ==="
    echo -e "\e[90m[Comparing nsconfig/ns.conf against collector running config output]\e[0m"
    RUN_CONF=$(find . -iname "*ns_running_config.conf*" -o -iname "*runningconfig*.txt" | head -n 1)
    SAVED_CONF=$(find . -path "*/nsconfig/ns.conf" | head -n 1)
    
    if [ -n "$SAVED_CONF" ] && [ -n "$RUN_CONF" ]; then
        diff -u "$SAVED_CONF" "$RUN_CONF" | grep -E "^\+|^-" | grep -v "^---" | grep -v "^+++"
    else
        echo "Could not locate either saved ns.conf or the running config output."
    fi
}

nssec() {
    echo -e "\n\e[1m=== 🚨 SUSPICIOUS PROCESSES & BACKDOORS ===\e[0m"
    find . -name "ps-alux*" -o -name "ps-aux*" -exec grep -HinE "curl|sh |python|wget|bash" {} + 2>/dev/null | grep -v "mps" || echo " -> Clean."
    
    echo -e "\n\e[1m=== 🚨 LOGON POINT FILES (Check for Web Shells) ===\e[0m"
    find . -path "*/netscaler/logon/LogonPoint/a*" -ls 2>/dev/null || echo " -> Clean."
    
    echo -e "\n\e[1m=== 🔐 MANAGEMENT LOGINS (SSH/GUI) ===\e[0m"
    echo -e "\e[90m[Source: var/log/auth.log* | Top 10 Failed/Success Accounts & IPs]\e[0m"
    local AUTH=$(find . -path "*/var/log/auth.log*")
    if [ -n "$AUTH" ]; then
        echo -e "\n[FAILED Attempts (Count | User/IP)]:"
        zgrep -iE "Failed password|authentication error" $AUTH 2>/dev/null | grep -oE "for [a-zA-Z0-9_-]+ from [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10 || echo " -> No failures found."
        echo -e "\n[SUCCESSFUL Logins (Count | User/IP)]:"
        zgrep -iE "Accepted password|session opened|Accepted publickey" $AUTH 2>/dev/null | grep -oE "for [a-zA-Z0-9_-]+ from [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10 || echo " -> No successful logins found."
    else
        echo " -> No auth.log files found."
    fi

    echo -e "\n\e[1m=== 🌍 GATEWAY / AAA VPN LOGINS ===\e[0m"
    echo -e "\e[90m\e[0m"
    local NSLOG=$(find . -path "*/var/log/ns.log*")
    if [ -n "$NSLOG" ]; then
        zgrep -i "LOGIN_FAILED" $NSLOG 2>/dev/null | grep -oE "User [^ ]+ - Client_ip [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10 || echo " -> No Gateway login failures found."
    fi
}

nscerts() {
    echo -e "\n=== 🔐 INSTANT SSL CERTIFICATE DECODER ==="
    find . -path "*/nsconfig/ssl/*" -type f \( -iname "*.cert" -o -iname "*.crt" -o -iname "*.pem" \) 2>/dev/null | while read cert; do
        echo -e "\n[FILE]: $cert"
        openssl x509 -in "$cert" -noout -subject -issuer -dates 2>/dev/null || echo "  -> Not a valid x509 cert"
    done
}

