# --------------------------------------------------------------------
# 2. SYSTEM DASHBOARD & TOPOLOGY
# --------------------------------------------------------------------
sysinfo() {
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1m 📊 SYSTEM INFORMATION DASHBOARD \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
    
    local ADM_VER=$(find . -path "*/mps/version.conf" 2>/dev/null | head -n 1)
    local AGENT_VER=$(find . -path "*/var/mps/nstelemetry/version.conf" 2>/dev/null | head -n 1)
    local ADC_CONF=$(find . -name "ns.conf" -path "*/nsconfig/ns.conf" 2>/dev/null | head -n 1)

    if [ -n "$ADM_VER" ]; then
        echo "[Type]     : NetScaler Console (ADM)"
        echo "[Version]  : $(cat "$ADM_VER" 2>/dev/null)"
    elif [ -n "$AGENT_VER" ]; then
        echo "[Type]     : NetScaler Console Agent"
        echo "[Version]  : $(cat "$AGENT_VER" 2>/dev/null)"
    elif [ -n "$ADC_CONF" ]; then
        local BLX_CONF=$(find . -path "*/etc/blx/blx.conf" 2>/dev/null | head -n 1)
        if [ -n "$BLX_CONF" ]; then
            echo "[Type]     : NetScaler BLX (Linux BareMetal)"
        else
            echo "[Type]     : NetScaler ADC"
        fi
        echo "[Version]  : $(grep -i -m 1 "NetScaler" "$ADC_CONF" 2>/dev/null | tr -d '# ')"
        local hw=$(find . -path "*/var/log/messages*" -o -path "*/var/nslog/dmesg*" -exec zgrep -i "NetScaler hardware" {} + 2>/dev/null | head -n 1 | awk -F 'NetScaler hardware ' '{print $2}')
        [ -n "$hw" ] && echo "[Model]    : $hw"
    fi
    
    # 🆕 Host Platform Detection
    local PLATFORM="Hardware / Unknown Virtualization"
    local DMI=$(find . -name "dmidecode.out" 2>/dev/null | head -n 1)
    if [ -n "$DMI" ]; then
        if grep -qi "Amazon" "$DMI"; then PLATFORM="AWS (Amazon EC2)"
        elif grep -qiE "Microsoft|Hyper-V" "$DMI"; then PLATFORM="Azure / Hyper-V"
        elif grep -qi "VMware" "$DMI"; then PLATFORM="VMware (ESXi)"
        elif grep -qiE "QEMU|KVM|Nutanix|Acropolis" "$DMI"; then PLATFORM="KVM / Nutanix / Proxmox"
        elif grep -qi "Xen" "$DMI"; then PLATFORM="Citrix Hypervisor (XenServer)"
        fi
    fi
    
    # If it's a BLX instance, read the os-release for the underlying Linux flavor
    local OS_RELEASE=$(find . -name "os-release.out" 2>/dev/null | head -n 1)
    if [ -n "$OS_RELEASE" ]; then
        local PRETTY_NAME=$(grep "^PRETTY_NAME=" "$OS_RELEASE" | cut -d '=' -f 2 | tr -d '"')
        [ -n "$PRETTY_NAME" ] && PLATFORM="BLX on $PRETTY_NAME"
    else
        local UNAME=$(find . -name "uname-a.out" 2>/dev/null | head -n 1)
        if [ -n "$UNAME" ] && grep -qi "Linux" "$UNAME"; then PLATFORM="NetScaler BLX (Linux BareMetal)"; fi
    fi
    echo "[Platform] : $PLATFORM"
    
    local UPTIME=$(find . -name "uptime.out" 2>/dev/null | head -n 1)
    [ -n "$UNAME" ] && echo "[Kernel]   : $(cat "$UNAME" 2>/dev/null)"
    [ -n "$UPTIME" ] && echo "[Uptime]   : $(cat "$UPTIME" 2>/dev/null)"
    echo "-----------------------------------------------------------------------"
    
    local SYSCTL=$(find . -name "sysctl-a.out" 2>/dev/null | head -n 1)
    if [ -n "$SYSCTL" ]; then
        local mem=$(grep -i "hw.physmem" "$SYSCTL" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
        [ -n "$mem" ] && [ "$mem" -gt 0 ] && echo "[Memory]   : ~$(( mem / 1024 / 1024 / 1024 )) GB allocated"
        local cpu=$(grep -i "hw.ncpu" "$SYSCTL" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
        [ -n "$cpu" ] && echo "[CPUs]     : $cpu allocated"
    fi
    echo -e "\e[1m=======================================================================\e[0m"
}

nsips() {
    echo -e "\n\e[1m=== 🌐 NETSCALER TOPOLOGY & IPs (For Wireshark Filters) ===\e[0m"
    local CONF=$(find . -name "ns.conf" -path "*/nsconfig/ns.conf" 2>/dev/null | head -n 1)
    if [ -n "$CONF" ]; then
        echo -e "\e[90m[NSIP & SNIPs (Management & Backend Routing)]:\e[0m"
        grep -iE "^add ns ip " "$CONF" | awk '{print "  - " $4 " (Mask: " $5 ")"}' | sort -u
        echo -e "\n\e[90m[Virtual Servers / VIPs (Frontend)]:\e[0m"
        grep -iE "^add (lb|cs|vpn) vserver " "$CONF" | awk '{print "  - " $4 " [" $2 " / " $3 "] -> " $5}' | sort -u
        echo -e "\n\e[90m[Backend Services / Servers]:\e[0m"
        grep -iE "^add server " "$CONF" | awk '{print "  - " $3 " -> " $4}' | sort -u
    else
        echo " -> ns.conf not found. Falling back to raw ifconfig..."
        find . -name "ifconfig-a.out" -exec grep -iE "inet " {} + 2>/dev/null | grep -v "127.0.0.1"
    fi
}

