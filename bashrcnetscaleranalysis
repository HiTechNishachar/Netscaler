# --------------------------------------------------------------------
# 1. NAVIGATION & ALIASES
# --------------------------------------------------------------------
alias ll='ls -lah'
alias lr='ls -lahR'
alias llr="find . -print | sed -e 's;[^/]*/;|____;g;s;____|; |;g'"
alias ..='cd ..'
alias ...='cd ../..'
alias csh='source ~/.bashrc'

# --------------------------------------------------------------------
# 2. SYSTEM DASHBOARD & TOPOLOGY
# --------------------------------------------------------------------
sysinfo() {
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1m 📊 SYSTEM INFORMATION DASHBOARD \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
    
    local ADM_VER=$(find . -path "*/mps/version.conf" 2>/dev/null | head -n 1)
    local AGENT_VER=$(find . -path "*/var/mps/nstelemetry/version.conf" 2>/dev/null | head -n 1)
    local ADC_CONF=$(find . -name "ns.conf" -path "*/nsconfig/ns.conf" 2>/dev/null | head -n 1)
    local HW_TYPE="Unknown"
    local SERIAL_NUM=""
    local PLATFORM="Hardware / Unknown Virtualization"

    if [ -n "$ADM_VER" ]; then
        echo "[Type]     : NetScaler Console (ADM)"
        echo "[Version]  : $(cat "$ADM_VER" 2>/dev/null)"
    elif [ -n "$AGENT_VER" ]; then
        echo "[Type]     : NetScaler Console Agent"
        echo "[Version]  : $(cat "$AGENT_VER" 2>/dev/null)"
    elif [ -n "$ADC_CONF" ]; then
        local BLX_CONF=$(find . -path "*/etc/blx/blx.conf" 2>/dev/null | head -n 1)
        if [ -n "$BLX_CONF" ]; then
            HW_TYPE="BLX"
            echo "[Type]     : NetScaler BLX (Linux BareMetal)"
        else
            local hw=$(find . -path "*/var/log/messages*" -o -path "*/var/nslog/dmesg*" -exec zgrep -i "NetScaler hardware" {} + 2>/dev/null | head -n 1 | awk -F 'NetScaler hardware ' '{print $2}')
            if echo "$hw" | grep -qi "Virtual"; then HW_TYPE="VPX"
            elif echo "$hw" | grep -qi "SDX"; then HW_TYPE="SDX"
            elif echo "$hw" | grep -qiE "MPX|CPX"; then HW_TYPE="MPX"
            else HW_TYPE="ADC (Unknown form factor)"
            fi
            echo "[Type]     : NetScaler $HW_TYPE"
        fi
        
        # 🆕 Fix Version Extraction (Grab exact release from top of ns.conf or showcmds)
        local ADC_VER=$(head -n 5 "$ADC_CONF" 2>/dev/null | grep -iE "^#.*NetScaler (NS|BLX)[0-9]" | head -n 1 | tr -d '# ')
        if [ -z "$ADC_VER" ]; then
            ADC_VER=$(find . -name "showcmds.txt" -exec awk '/show version/{getline; print}' {} + 2>/dev/null | head -n 1)
        fi
        echo "[Version]  : ${ADC_VER:-Version not found in ns.conf or showcmds}"
        
        [ -n "$hw" ] && echo "[Model]    : $hw"
        
        if [[ "$HW_TYPE" == "MPX" || "$HW_TYPE" == "SDX" ]]; then
            SERIAL_NUM=$(find . -name "showtech_info.out" -exec grep -i "Serial" {} + 2>/dev/null | head -n 1)
            [ -z "$SERIAL_NUM" ] && SERIAL_NUM=$(find . -path "*/var/log/messages*" -exec zgrep -i "Serial Number" {} + 2>/dev/null | head -n 1)
            [ -n "$SERIAL_NUM" ] && echo "[Serial]   : $SERIAL_NUM"
        fi
    fi
    
    # 🆕 Extract HA State directly into dashboard
    local HA_STATE=$(find . -name "show_ha.txt" -exec grep -iE "^Node State" {} + 2>/dev/null | head -n 1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$HA_STATE" ] && echo "[HA State] : $HA_STATE"
    
    # Platform Detection
    local DMI=$(find . -name "dmidecode.out" 2>/dev/null | head -n 1)
    if [ -n "$DMI" ]; then
        if grep -qi "Amazon" "$DMI"; then PLATFORM="AWS (Amazon EC2)"
        elif grep -qiE "Microsoft|Hyper-V" "$DMI"; then PLATFORM="Azure / Hyper-V"
        elif grep -qi "VMware" "$DMI"; then PLATFORM="VMware (ESXi)"
        elif grep -qiE "QEMU|KVM|Nutanix|Acropolis" "$DMI"; then PLATFORM="KVM / Nutanix / Proxmox"
        elif grep -qi "Xen" "$DMI"; then PLATFORM="Citrix Hypervisor (XenServer)"
        fi
    fi
    
    local OS_RELEASE=$(find . -name "os-release.out" 2>/dev/null | head -n 1)
    local UNAME=$(find . -name "uname-a.out" 2>/dev/null | head -n 1)
    if [ -n "$OS_RELEASE" ]; then
        local PRETTY_NAME=$(grep "^PRETTY_NAME=" "$OS_RELEASE" | cut -d '=' -f 2 | tr -d '"')
        [ -n "$PRETTY_NAME" ] && PLATFORM="BLX on $PRETTY_NAME"
    elif [ -n "$UNAME" ] && grep -qi "Linux" "$UNAME"; then 
        PLATFORM="NetScaler BLX (Linux BareMetal)"
    fi
    echo "[Platform] : $PLATFORM"
    
    local UPTIME=$(find . -name "uptime.out" 2>/dev/null | head -n 1)
    [ -n "$UNAME" ] && echo "[Kernel]   : $(cat "$UNAME" 2>/dev/null)"
    [ -n "$UPTIME" ] && echo "[Uptime]   : $(cat "$UPTIME" 2>/dev/null)"
    echo "-----------------------------------------------------------------------"
    
    local SYSCTL=$(find . -name "sysctl-a.out" 2>/dev/null | head -n 1)
    if [ -n "$SYSCTL" ]; then
        local mem=$(grep -i "hw.physmem" "$SYSCTL" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
        [ -n "$mem" ] && [ "$mem" -gt 0 ] && echo "[Memory]   : ~$(( mem / 1024 / 1024 / 1024 )) GB allocated"
        local cpu=$(grep -i "hw.ncpu" "$SYSCTL" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
        [ -n "$cpu" ] && echo "[CPUs]     : $cpu allocated"
    fi
    echo -e "\e[1m=======================================================================\e[0m"
}

nsips() {
    echo -e "\n\e[1m=== 🌐 NETSCALER TOPOLOGY & IPs (For Wireshark Filters) ===\e[0m"
    local CONF=$(find . -name "ns.conf" -path "*/nsconfig/ns.conf" 2>/dev/null | head -n 1)
    if [ -n "$CONF" ]; then
        echo -e "\e[90m[NSIP & SNIPs (Management & Backend Routing)]:\e[0m"
        grep -iE "^add ns ip " "$CONF" | awk '{print "  - " $4 " (Mask: " $5 ")"}' | sort -u
        echo -e "\n\e[90m[Virtual Servers / VIPs (Frontend)]:\e[0m"
        grep -iE "^add (lb|cs|vpn) vserver " "$CONF" | awk '{print "  - " $4 " [" $2 " / " $3 "] -> " $5}' | sort -u
        echo -e "\n\e[90m[Backend Services / Servers]:\e[0m"
        grep -iE "^add server " "$CONF" | awk '{print "  - " $3 " -> " $4}' | sort -u
    else
        echo " -> ns.conf not found. Falling back to raw ifconfig..."
        local IF_OUT=$(find . -name "ifconfig-a.out" 2>/dev/null | head -n 1)
        if [ -n "$IF_OUT" ]; then
            grep -iE "inet " "$IF_OUT" 2>/dev/null | grep -v "127.0.0.1"
        else
            echo " -> No ifconfig data found in bundle."
        fi
    fi
}

nsha() {
    echo -e "\n\e[1m=== 🔄 HA NODE STATE ===\e[0m"
    echo -e "\e[90m[Checking 'show_ha.txt' or telemetry logs for HA state transitions...]\e[0m"
    local HA_OUT=$(find . -name "show_ha.txt" 2>/dev/null | head -n 1)
    if [ -n "$HA_OUT" ] && [ -s "$HA_OUT" ]; then 
        cat "$HA_OUT"
    else 
        echo -e "[Proof Cmd]: nsconmsg -K var/nslog/newnslog -d event"
        local HA_EV=$(find . -name "newnslog" -exec nsconmsg -K {} -d event \; 2>/dev/null | grep -iE "ha_state|remote node|master" | tail -n 10)
        [ -n "$HA_EV" ] && echo "$HA_EV" || echo " -> No HA state transitions found in newnslog."
    fi
}

nslic() {
    echo -e "\n\e[1m=== 🔑 LICENSE AUDIT (LAS & Legacy) ===\e[0m"
    echo -e "\e[90m[Checking 'show ns license' output in collector...]\e[0m"
    local LIC_CMD=$(find . -name "showcmds.txt" -o -name "show_ns_license.txt" 2>/dev/null | head -n 1)
    if [ -n "$LIC_CMD" ]; then
        local LIC_OUT=$(awk '/show (ns )?license/{flag=1; print; next} /^(>|root@|show )/{if(flag) {flag=0; exit}} flag' "$LIC_CMD" 2>/dev/null | head -n 30)
        [ -n "$LIC_OUT" ] && echo "$LIC_OUT" || echo " -> License command output not found in showcmds.txt."
    else
        echo " -> No 'show license' command output found in bundle."
    fi
    
    echo -e "\n\e[90m[Checking for legacy .lic files (Can cause conflicts!)]\e[0m"
    local OLD_LICS=$(find . -path "*/nsconfig/license/*" -name "*.lic" 2>/dev/null)
    if [ -n "$OLD_LICS" ]; then
        echo -e "\e[33m⚠️ WARNING: Legacy .lic files found in /nsconfig/license/. These are deprecated and may conflict with LAS!\e[0m"
        ls -lah $OLD_LICS
    else
        echo " -> Clean (No legacy .lic files found)."
    fi

    echo -e "\n\e[90m[Checking logs for expiration / grace period warnings...]\e[0m"
    local LIC_WARN=$(find . -path "*/var/log/messages*" -o -path "*/var/log/ns.log*" -exec zgrep -HinE "grace period|license.*expired|maximum.*limit" {} + 2>/dev/null | tail -n 10)
    [ -n "$LIC_WARN" ] && echo "$LIC_WARN" || echo " -> No expiration warnings found in logs."
}

# --------------------------------------------------------------------
# 3. 🚀 THE MASTER TRIAGE ENGINE
# --------------------------------------------------------------------
nstriage() {
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1m 🚀 INITIATING AUTOMATED MASTER TRIAGE (HUNTING 99.9% OF ISSUES) \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
    
    local IS_ADM=$(find . -type d -name "mps" 2>/dev/null | wc -l)
    
    # --- 1. CRITICAL: DISK SPACE & CORE DUMPS ---
    echo -e "\n\e[1m[!] 1. STORAGE & SYSTEM PANICS (Checking /var, /tmp, /flash capacity & Core Dumps)\e[0m"
    echo -e "\e[90m[Source]: shell/df-*.out | var/crash/ | var/log/messages*\e[0m"
    echo "-----------------------------------------------------------------------"
    local DISK_FILE=$(find . -name "df-akin.out" -o -name "df-kh.out" -o -name "df-h.out" -o -name "disk_usage.txt" 2>/dev/null | head -n 1)
    if [ -n "$DISK_FILE" ]; then
        local HIGH_USAGE=$(grep -E "100%|9[0-9]%" "$DISK_FILE" 2>/dev/null)
        if [ -n "$HIGH_USAGE" ]; then
            local CRIT_PARTS=$(echo "$HIGH_USAGE" | grep -iE "/var$|/tmp$|/var/tmp$|/flash$")
            local OTHER_PARTS=$(echo "$HIGH_USAGE" | grep -ivE "/var$|/tmp$|/var/tmp$|/flash$")
            
            if [ -n "$CRIT_PARTS" ]; then
                echo -e "\e[31m -> ⚠️ CRITICAL: Essential partitions (/var, /tmp, /flash) are above 90%:\e[0m"
                echo "$CRIT_PARTS" | awk '{print "      " $NF " is at " $(NF-1)}'
            else
                echo " -> Critical partitions (/var, /tmp, /flash) are OK."
            fi
            
            if [ -n "$OTHER_PARTS" ]; then
                echo -e "\e[93m -> Note: Other non-critical partitions are above 90%:\e[0m"
                echo "$OTHER_PARTS" | awk '{print "      " $NF " is at " $(NF-1)}'
            fi
        else
            echo " -> Disk Space: OK (No partitions over 90%)."
        fi
        
        local VAR_AVAIL=$(awk '$NF=="/var" {print $4}' "$DISK_FILE" 2>/dev/null)
        if [ -n "$VAR_AVAIL" ]; then
            local VAR_VAL=$(echo "$VAR_AVAIL" | grep -oE "[0-9]+")
            local VAR_UNIT=$(echo "$VAR_AVAIL" | grep -oE "[A-Za-z]+")
            
            if [[ "$VAR_UNIT" == "G" || "$VAR_UNIT" == "GB" ]]; then
                if [ "$VAR_VAL" -lt 7 ]; then
                   echo -e "\e[31m -> ⚠️ WARNING: /var has less than 7GB free ($VAR_AVAIL remaining).\e[0m"
                else
                   echo " -> /var Space: OK ($VAR_AVAIL available)."
                fi
            elif [[ "$VAR_UNIT" == "M" || "$VAR_UNIT" == "MB" || "$VAR_UNIT" == "K" || "$VAR_UNIT" == "KB" ]]; then
                echo -e "\e[31m -> ⚠️ WARNING: /var has critically low space ($VAR_AVAIL remaining).\e[0m"
            else
                echo " -> /var Available Space: $VAR_AVAIL"
            fi
        fi
    else
        echo " -> Disk log not found."
    fi
    
    local CORES=$(find . -type d \( -name "crash" -o -name "core" \) -exec ls -latr {} + 2>/dev/null | grep -v "^total")
    [ -n "$CORES" ] && echo "$CORES" || echo " -> Core Dumps: None found."
    
    local BOOT_EV=$(find . -path "*/var/log/messages*" -o -path "*/var/nslog/dmesg*" -exec zgrep -HinE "booting|FreeBSD|panic|core dumped" {} + 2>/dev/null | tail -n 5)
    [ -n "$BOOT_EV" ] && echo "$BOOT_EV" || echo " -> No boot/panic events found."

    # --- 2. L2/L3 NETWORK & ARP CHAOS ---
    echo -e "\n\e[1m[!] 2. NETWORK ANOMALIES (Duplicate IPs, MAC Flaps, Routing Drops)\e[0m"
    echo "-----------------------------------------------------------------------"
    local NET_ANOM=$(find . -path "*/var/log/messages*" -exec zgrep -HinE "duplicate IP|moved from|arp info overwritten|MAC address has changed" {} + 2>/dev/null | tail -n 10)
    [ -n "$NET_ANOM" ] && echo "$NET_ANOM" || echo " -> ARP/MAC: No immediate network chaos detected."

    if [ "$IS_ADM" -eq 0 ]; then
        echo -e "\n\e[1m[!] 3. CPU & MEMORY EXHAUSTION (Is the box choking?)\e[0m"
        echo "-----------------------------------------------------------------------"
        local HW_DR=$(find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'mem_err|mbuf|cpu_err|cpu_use' | grep -v -w '0')
        [ -n "$HW_DR" ] && echo "$HW_DR" || echo " -> Telemetry: No severe CPU/Memory drops recorded."

        echo -e "\n\e[1m[!] 4. LICENSING & RATE LIMITS (Are they hitting their licensed cap?)\e[0m"
        echo "-----------------------------------------------------------------------"
        local LIC_DR=$(find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'limit_drop|bw_limit|max_clients|rate_limit' | grep -v -w '0')
        [ -n "$LIC_DR" ] && echo "$LIC_DR" || echo " -> No telemetry limit drops found."
        
        local LIC_MSG=$(find . -path "*/var/log/messages*" -exec zgrep -HinE "license.*expired|grace period" {} + 2>/dev/null | tail -n 3)
        [ -n "$LIC_MSG" ] && echo "$LIC_MSG" || echo " -> No license expiration logs found."

        echo -e "\n\e[1m[!] 5. HA STATE CHANGES (Did it failover?)\e[0m"
        echo "-----------------------------------------------------------------------"
        local HA_EV=$(find . -name "newnslog" -exec nsconmsg -K {} -d event \; 2>/dev/null | grep -iE 'ha_state' | tail -n 10)
        [ -n "$HA_EV" ] && echo "$HA_EV" || echo " -> No HA state changes found in telemetry."

        echo -e "\n\e[1m[!] 6. GATEWAY/AAA FAILURES (SAML, LDAP, RADIUS, STA)\e[0m"
        echo "-----------------------------------------------------------------------"
        local AAA_FAIL=$(find . -path "*/var/log/ns.log*" -exec zgrep -HinE "LOGIN_FAILED|AAA_LOGIN|SAML.*FAILED|LDAP.*FAILED|EPA_FAIL|STA ticket" {} + 2>/dev/null | tail -n 15)
        [ -n "$AAA_FAIL" ] && echo "$AAA_FAIL" || echo " -> No Gateway/AAA failures found in ns.log."

        echo -e "\n\e[1m[!] 7. WAF & SECURITY POLICIES (Is AppFW blocking legitimate traffic?)\e[0m"
        echo "-----------------------------------------------------------------------"
        local WAF_DR=$(find . -path "*/var/log/ns.log*" -exec zgrep -HinE "APPFW_.*_BLOCKED|APPFW_.*_DROPPED|BOT_.*_BLOCKED" {} + 2>/dev/null | tail -n 10)
        [ -n "$WAF_DR" ] && echo "$WAF_DR" || echo " -> WAF: No recent AppFW blocks found."
        
        echo -e "\n\e[1m[!] 8. SSL HANDSHAKES & BACKEND MONITORS (Are servers down?)\e[0m"
        echo "-----------------------------------------------------------------------"
        local MON_FAIL=$(find . -path "*/var/log/notice.log*" -exec zgrep -HinE "DOWN|UP" {} + 2>/dev/null | grep -iE "monitor|service|server" | tail -n 10)
        [ -n "$MON_FAIL" ] && echo "$MON_FAIL" || echo " -> No monitor UP/DOWN events found in notice.log."
        
        local SSL_FAIL=$(find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'handshake_fail|cipher_mismatch|retransmit' | grep -v -w '0')
        [ -n "$SSL_FAIL" ] && echo "$SSL_FAIL" || echo " -> No SSL handshake failures found in telemetry."
    else
        echo -e "\n\e[1m[!] ADM / AGENT: CRITICAL SUBSYSTEM ERRORS\e[0m"
        echo "-----------------------------------------------------------------------"
        local ADM_ERR=0
        for logfile in "mps_agent.log" "inventory.log" "mps_sync.log" "mps_event.log" "inventory_debug.log" "mas.log" "nstelemetry.log" "mps_afdecoder.log" "mps_cloudagent.log" "mps_service.log"; do
            local ERR_OUT=$(find . -path "*/var/mps/log/*" -name "$logfile*" -exec zgrep -HinE 'ERROR|FATAL|Traceback' {} + 2>/dev/null | tail -n 5)
            if [ -n "$ERR_OUT" ]; then
                echo "$ERR_OUT"
                ADM_ERR=1
            fi
        done
        [ $ADM_ERR -eq 0 ] && echo " -> No critical subsystem errors found."
    fi
    echo -e "\n\e[1m=======================================================================\e[0m"
}
alias nstriage_save="nstriage | sed 's/\x1b\[[0-9;]*m//g' | tee nstriage_output.txt; echo -e '\n[✔] Clean output saved to nstriage_output.txt'"

# --------------------------------------------------------------------
# 4. EXPERT TOOLS, SECURITY & LOGINS
# --------------------------------------------------------------------
nsdiff() {
    echo -e "\n\e[1m=== SAVED vs RUNNING CONFIG DIFFERENCE ===\e[0m"
    local RUN_CONF=$(find . -iname "*ns_running_config.conf*" -o -iname "*runningconfig*.txt" | head -n 1)
    local SAVED_CONF=$(find . -path "*/nsconfig/ns.conf" | head -n 1)
    
    if [ -n "$SAVED_CONF" ] && [ -n "$RUN_CONF" ]; then
        echo -e "\e[90m[Saved Config]   : $SAVED_CONF"
        echo -e "[Running Config] : $RUN_CONF\e[0m"
        echo -e "\e[33m[Legend] '-' means line is in SAVED but MISSING in RUNNING."
        echo -e "         '+' means line is in RUNNING but NOT SAVED to disk.\e[0m\n"
        diff -u "$SAVED_CONF" "$RUN_CONF" | grep -E "^\+|^-" | grep -v "^---" | grep -v "^+++" || echo " -> Configs are identical."
    else
        echo " -> Could not locate either saved ns.conf or the running config output."
    fi
}

nssec() {
    echo -e "\n\e[1m=== 🚨 SUSPICIOUS PROCESSES & BACKDOORS ===\e[0m"
    echo -e "\e[90m[Checking ps-aux* for curl, wget, python, bash...]\e[0m"
    local SUSP=$(find . -name "ps-alux*" -o -name "ps-aux*" -exec grep -HinE "curl|sh |python|wget|bash" {} + 2>/dev/null | grep -v "mps")
    [ -n "$SUSP" ] && echo "$SUSP" || echo " -> Clean."
    
    echo -e "\n\e[1m=== 🚨 LOGON POINT FILES (Check for Web Shells) ===\e[0m"
    echo -e "\e[90m[Checking /netscaler/logon/LogonPoint/a*...]\e[0m"
    local LPOINT=$(find . -path "*/netscaler/logon/LogonPoint/a*" -ls 2>/dev/null)
    [ -n "$LPOINT" ] && echo "$LPOINT" || echo " -> Clean."
    
    echo -e "\n\e[1m=== 🔐 MANAGEMENT LOGINS (SSH/GUI) ===\e[0m"
    echo -e "\e[90m\e[0m"
    local AUTH=$(find . -path "*/var/log/auth.log*")
    if [ -n "$AUTH" ]; then
        echo -e "\n[FAILED Attempts (Count | User/IP)]:"
        local FAIL_AUTH=$(zgrep -iE "Failed password|authentication error" $AUTH 2>/dev/null | grep -oE "for [a-zA-Z0-9_-]+ from [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10)
        [ -n "$FAIL_AUTH" ] && echo "$FAIL_AUTH" || echo " -> No failures found."
        
        echo -e "\n[SUCCESSFUL Logins (Count | User/IP)]:"
        local SUCC_AUTH=$(zgrep -iE "Accepted password|session opened|Accepted publickey" $AUTH 2>/dev/null | grep -oE "for [a-zA-Z0-9_-]+ from [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10)
        [ -n "$SUCC_AUTH" ] && echo "$SUCC_AUTH" || echo " -> No successful logins found."
    else
        echo " -> No auth.log files found."
    fi

    echo -e "\n\e[1m=== 🌍 GATEWAY / AAA VPN LOGINS ===\e[0m"
    echo -e "\e[90m\e[0m"
    local NSLOG=$(find . -path "*/var/log/ns.log*")
    if [ -n "$NSLOG" ]; then
        local VPN_FAIL=$(zgrep -i "LOGIN_FAILED" $NSLOG 2>/dev/null | grep -oE "User [^ ]+ - Client_ip [0-9\.]+" | sort | uniq -c | sort -nr | head -n 10)
        [ -n "$VPN_FAIL" ] && echo "$VPN_FAIL" || echo " -> No Gateway login failures found."
    else
        echo " -> No ns.log files found."
    fi
}

nscerts() {
    echo -e "\n\e[1m=== 🔐 INSTANT SSL CERTIFICATE DECODER ===\e[0m"
    echo -e "\e[90m[Checking nsconfig/ssl/ for .cert, .crt, .pem...]\e[0m"
    local CERTS=$(find . -path "*/nsconfig/ssl/*" -type f \( -iname "*.cert" -o -iname "*.crt" -o -iname "*.pem" \) 2>/dev/null)
    if [ -n "$CERTS" ]; then
        echo "$CERTS" | while read cert; do
            echo -e "\n[FILE]: $cert"
            openssl x509 -in "$cert" -noout -subject -issuer -dates 2>/dev/null || echo "  -> Not a valid x509 cert"
        done
    else
        echo " -> No SSL certificates found in nsconfig/ssl/."
    fi
}

nsps() {
    echo -e "\n\e[1m[Hunting processes in ps-alux* or ps-aux*...]\e[0m"
    if [ -z "$1" ]; then 
        local PS_FILE=$(find . -name "ps-alux*" -o -name "ps-aux*" 2>/dev/null | head -n 1)
        if [ -n "$PS_FILE" ]; then 
            cat "$PS_FILE"
        else 
            echo " -> No ps output file found in bundle."
        fi
    else 
        local MAT=$(find . -name "ps-alux*" -o -name "ps-aux*" -exec grep -HinE "$1" {} + 2>/dev/null)
        [ -n "$MAT" ] && echo "$MAT" || echo " -> No matches found for '$1'."
    fi
}

# --- SMART GREP FUNCTIONS (Replaced Aliases for Local Scope Support) ---
nscrashes() {
    echo -e "\n\e[1m[Hunting Core/Crash Dumps in /var/crash and /var/core...]\e[0m"
    local CR=$(find . -type d \( -name "crash" -o -name "core" \) -exec ls -latr {} + 2>/dev/null | grep -v "^total")
    [ -n "$CR" ] && echo "$CR" || echo " -> None found."
}
nsboot() {
    echo -e "\n\e[1m[Hunting Reboots & Panics in /var/log/messages* & dmesg*...]\e[0m"
    local BT=$(find . -path "*/var/log/messages*" -o -path "*/var/nslog/dmesg*" -exec zgrep -HinE "booting|FreeBSD|panic|reboot" {} + 2>/dev/null)
    [ -n "$BT" ] && echo "$BT" || echo " -> None found."
}
nsnotice() {
    echo -e "\n\e[1m[Hunting Monitor UP/DOWN Flaps in /var/log/notice.log*...]\e[0m"
