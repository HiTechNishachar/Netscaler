# --------------------------------------------------------------------
# 5. INTERACTIVE LOG SEARCH & VIEWER
# --------------------------------------------------------------------
nscfg() { 
    if [ -z "$1" ]; then 
        local files=( $(find . -path "*/nsconfig/ns.conf*" | sort -V 2>/dev/null) )
        if [ ${#files[@]} -eq 0 ]; then echo "No ns.conf files found."; return; fi
        for i in "${!files[@]}"; do
            echo -e "\\n\\e[1m==========================================================\\e[0m"
            echo -e "\\e[1m [DUMPING: ${files[$i]}] \\e[0m"
            echo -e "\\e[1m==========================================================\\e[0m"
            cat "${files[$i]}"
            if [ $i -lt $(( ${#files[@]} - 1 )) ]; then
                read -p "Press [Enter] to flood the next older file (${files[$((i+1))]}), or type 'q' to quit: " choice
                if [[ "$choice" == "q" || "$choice" == "Q" ]]; then echo "Exiting..."; break; fi
            fi
        done
    else 
        local MAT=$(find . -path "*/nsconfig/ns.conf*" -exec grep -HinE "$1" {} + 2>/dev/null)
        [ -n "$MAT" ] && echo "$MAT" || echo " -> No matches found."
    fi 
}

nslg() { 
    if [ -z "$1" ]; then 
        local files=( $(find . -path "*/var/log/ns.log*" | sort -V 2>/dev/null) )
        if [ ${#files[@]} -eq 0 ]; then echo "No ns.log files found."; return; fi
        for i in "${!files[@]}"; do
            echo -e "\\n\\e[1m==========================================================\\e[0m"
            echo -e "\\e[1m [DUMPING: ${files[$i]}] \\e[0m"
            echo -e "\\e[1m==========================================================\\e[0m"
            zcat -f "${files[$i]}"
            if [ $i -lt $(( ${#files[@]} - 1 )) ]; then
                read -p "Press [Enter] to flood the next older log (${files[$((i+1))]}), or type 'q' to quit: " choice
                if [[ "$choice" == "q" || "$choice" == "Q" ]]; then echo "Exiting..."; break; fi
            fi
        done
    else 
        local MAT=$(find . -path "*/var/log/ns.log*" -exec zgrep -HinE "$1" {} + 2>/dev/null)
        [ -n "$MAT" ] && echo "$MAT" || echo " -> No matches found."
    fi 
}

nsroute() { if [ -z "$1" ]; then local RO=$(find . -name "netstat-rn.out" -exec cat {} + 2>/dev/null); [ -n "$RO" ] && echo "$RO" || echo "-> Not found."; else local MAT=$(find . -name "netstat-rn.out" -exec grep -HinE "$1" {} + 2>/dev/null); [ -n "$MAT" ] && echo "$MAT" || echo "-> No matches."; fi; }
nstime(){ local MAT=$(find . -path "*/var/log/ns.log*" -o -path "*/var/log/messages*" -exec zgrep -HinE "$1" {} + 2>/dev/null); [ -n "$MAT" ] && echo "$MAT" || echo "-> No matches."; }
mpslg() { local MAT=$(find . -path "*/var/mps/log/*" -o -path "*/var/sdc/log/*" -type f -exec zgrep -HinE "$1" {} + 2>/dev/null); [ -n "$MAT" ] && echo "$MAT" || echo "-> No matches."; }
cs() { cd "/upload/ftp/$1" 2>/dev/null || echo "Usage: cs <case_number>"; }
ff()  { find . -type f -iname "*$1*"; }
ft()  { grep -rni "$1" . ; }

