# --------------------------------------------------------------------
# 3. 🚀 THE MASTER TRIAGE ENGINE (Drunk-Proof Analysis)
# --------------------------------------------------------------------
nstriage() {
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1m 🚀 INITIATING AUTOMATED MASTER TRIAGE (HUNTING 99.9% OF ISSUES) \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
    
    local IS_ADM=$(find . -type d -name "mps" 2>/dev/null | wc -l)
    
    # --- 1. CRITICAL: DISK SPACE & CORE DUMPS ---
    echo -e "\n\e[1m[!] 1. STORAGE & SYSTEM PANICS (Did the box die or run out of room?)\e[0m"
    echo -e "\e[90m[Source]: shell/df-akin.out | var/crash/ | var/log/messages* | var/nslog/dmesg*\e[0m"
    echo "-----------------------------------------------------------------------"
    local DISK_FILE=$(find . -name "df-akin.out" -o -name "disk_usage.txt" | head -n 1)
    if [ -n "$DISK_FILE" ]; then
        grep -E "100%|9[0-9]%" "$DISK_FILE" 2>/dev/null || echo " -> Disk Space: OK (No partitions over 90%)."
    else
        echo " -> Disk log not found."
    fi
    find . -type d \( -name "crash" -o -name "core" \) -exec ls -latr {} + 2>/dev/null | grep -v "^total" || echo " -> Core Dumps: None found."
    find . -path "*/var/log/messages*" -o -path "*/var/nslog/dmesg*" -exec zgrep -HinE "booting|FreeBSD|panic|core dumped" {} + 2>/dev/null | tail -n 5

    # --- 2. L2/L3 NETWORK & ARP CHAOS ---
    echo -e "\n\e[1m[!] 2. NETWORK ANOMALIES (Duplicate IPs, MAC Flaps, Routing Drops)\e[0m"
    echo -e "\e[90m[Source]: var/log/messages* | [Format]: File:Line:Log\e[0m"
    echo "-----------------------------------------------------------------------"
    find . -path "*/var/log/messages*" -exec zgrep -HinE "duplicate IP|moved from|arp info overwritten|MAC address has changed" {} + 2>/dev/null | tail -n 10 || echo " -> ARP/MAC: No immediate network chaos detected."

    if [ "$IS_ADM" -eq 0 ]; then
        # --- 3. ADC: MEMORY (MBUF) & HIGH CPU ---
        echo -e "\n\e[1m[!] 3. CPU & MEMORY EXHAUSTION (Is the box choking?)\e[0m"
        echo -e "\e[90m[Proof Cmd]: nsconmsg -K var/nslog/newnslog -s totaled -d statns\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'mem_err|mbuf|cpu_err|cpu_use' | grep -v -w '0' || echo " -> Telemetry: No severe CPU/Memory drops recorded."

        # --- 4. ADC: LICENSING & THROUGHPUT LIMITS ---
        echo -e "\n\e[1m[!] 4. LICENSING & RATE LIMITS (Are they hitting their licensed cap?)\e[0m"
        echo -e "\e[90m[Proof Cmd]: nsconmsg -K var/nslog/newnslog -s totaled -d statns | [Source]: messages*\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'limit_drop|bw_limit|max_clients|rate_limit' | grep -v -w '0'
        find . -path "*/var/log/messages*" -exec zgrep -HinE "license.*expired|grace period" {} + 2>/dev/null | tail -n 3

        # --- 5. ADC: HA FAILOVERS ---
        echo -e "\n\e[1m[!] 5. HA STATE CHANGES (Did it failover?)\e[0m"
        echo -e "\e[90m[Proof Cmd]: nsconmsg -K var/nslog/newnslog -d event\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -name "newnslog" -exec nsconmsg -K {} -d event \; 2>/dev/null | grep -iE 'ha_state' | tail -n 10

        # --- 6. ADC: GATEWAY & AAA AUTHENTICATION ---
        echo -e "\n\e[1m[!] 6. GATEWAY/AAA FAILURES (SAML, LDAP, RADIUS, STA)\e[0m"
        echo -e "\e[90m[Source]: var/log/ns.log* | [Format]: File:Line:Log\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -path "*/var/log/ns.log*" -exec zgrep -HinE "LOGIN_FAILED|AAA_LOGIN|SAML.*FAILED|LDAP.*FAILED|EPA_FAIL|STA ticket" {} + 2>/dev/null | tail -n 15

        # --- 7. ADC: WEB APP FIREWALL (WAF) DROPS ---
        echo -e "\n\e[1m[!] 7. WAF & SECURITY POLICIES (Is AppFW blocking legitimate traffic?)\e[0m"
        echo -e "\e[90m[Source]: var/log/ns.log* | [Format]: File:Line:Log\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -path "*/var/log/ns.log*" -exec zgrep -HinE "APPFW_.*_BLOCKED|APPFW_.*_DROPPED|BOT_.*_BLOCKED" {} + 2>/dev/null | tail -n 10 || echo " -> WAF: No recent AppFW blocks found."
        
        # --- 8. ADC: SSL & BACKEND HEALTH ---
        echo -e "\n\e[1m[!] 8. SSL HANDSHAKES & BACKEND MONITORS (Are servers down?)\e[0m"
        echo -e "\e[90m[Source]: var/log/notice.log* | [Proof Cmd]: nsconmsg -K newnslog -s totaled -d statns\e[0m"
        echo "-----------------------------------------------------------------------"
        find . -path "*/var/log/notice.log*" -exec zgrep -HinE "DOWN|UP" {} + 2>/dev/null | grep -iE "monitor|service|server" | tail -n 10
        find . -name "newnslog" -exec nsconmsg -K {} -s totaled -d statns \; 2>/dev/null | grep -iE 'handshake_fail|cipher_mismatch|retransmit' | grep -v -w '0'
        
    else
        # --- 9. ADM: CRITICAL SUBSYSTEM ERRORS ---
        echo -e "\n\e[1m[!] ADM / AGENT: CRITICAL SUBSYSTEM ERRORS\e[0m"
        echo -e "\e[90m[Source]: var/mps/log/* | [Format]: File:Line:Log\e[0m"
        echo "-----------------------------------------------------------------------"
        for logfile in "mps_agent.log" "inventory.log" "mps_sync.log" "mps_event.log" "inventory_debug.log" "mas.log" "nstelemetry.log" "mps_afdecoder.log" "mps_cloudagent.log" "mps_service.log"; do
            find . -path "*/var/mps/log/*" -name "$logfile*" -exec zgrep -HinE 'ERROR|FATAL|Traceback' {} + 2>/dev/null | tail -n 5
        done
    fi
    echo -e "\n\e[1m=======================================================================\e[0m"
    echo -e "\e[1m ✅ TRIAGE COMPLETE \e[0m"
    echo -e "\e[1m=======================================================================\e[0m"
}

# --------------------------------------------------------------------
# 4. EXPERT TOOLS & SMART FILTERS
# --------------------------------------------------------------------
nsdiff() {
    echo -e "\n=== SAVED vs RUNNING CONFIG DIFFERENCE ==="
    echo -e "\e[90m[Comparing nsconfig/ns.conf against collector running config output]\e[0m"
    # Updated to reflect real-world bundle naming for running config
    RUN_CONF=$(find . -iname "*ns_running_config.conf*" -o -iname "*runningconfig*.txt" | head -n 1)
    SAVED_CONF=$(find . -path "*/nsconfig/ns.conf" | head -n 1)
    
    if [ -n "$SAVED_CONF" ] && [ -n "$RUN_CONF" ]; then
        diff -u "$SAVED_CONF" "$RUN_CONF" | grep -E "^\+|^-" | grep -v "^---" | grep -v "^+++"
    else
        echo "Could not locate either saved ns.conf or the running config output."
    fi
}

nssec() {
    echo -e "\n=== SUSPICIOUS PROCESSES (curl, sh, python) ==="
    echo -e "\e[90m[Source]: shell/ps-alux*\e[0m"
    find . -name "ps-alux*" -exec grep -HinE "curl|sh |python|wget|bash" {} + 2>/dev/null | grep -v "mps"
    echo -e "\n=== LOGON POINT FILES (Check for Web Shells) ==="
    echo -e "\e[90m[Source]: find . -path '*/netscaler/logon/LogonPoint/a*'\e[0m"
    find . -path "*/netscaler/logon/LogonPoint/a*" -ls 2>/dev/null
    echo -e "\n=== CRON JOBS ==="
    echo -e "\e[90m[Source]: var/cron/tabs/root & etc/crontab\e[0m"
    find . -path "*/var/cron/tabs/root" -exec cat {} + 2>/dev/null
    find . -path "*/etc/crontab" -exec cat {} + 2>/dev/null
}

nscerts() {
    echo -e "\n=== 🔐 INSTANT SSL CERTIFICATE DECODER ==="
    echo -e "\e[90m[Extracting Expiration & Issuer data from /nsconfig/ssl/...]\e[0m"
    find . -path "*/nsconfig/ssl/*" -type f \( -iname "*.cert" -o -iname "*.crt" -o -iname "*.pem" \) 2>/dev/null | while read cert; do
        echo -e "\n[FILE]: $cert"
        openssl x509 -in "$cert" -noout -subject -issuer -dates 2>/dev/null || echo "  -> Not a valid x509 cert"
    done
}

