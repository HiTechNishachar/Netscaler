# ADC: View ns.conf interactively, or search if argument given
nscfg() { 
    if [ -z "$1" ]; then 
        local files=( $(find . -path "*/nsconfig/ns.conf*" | sort -V 2>/dev/null) )
        if [ ${#files[@]} -eq 0 ]; then echo "No ns.conf files found."; return; fi
        
        for i in "${!files[@]}"; do
            echo -e "\n\e[1m==========================================================\e[0m"
            echo -e "\e[1m 📄 DUMPING: ${files[$i]} \e[0m"
            echo -e "\e[1m==========================================================\e[0m"
            sleep 1
            cat "${files[$i]}"
            
            if [ $i -lt $(( ${#files[@]} - 1 )) ]; then
                echo -e "\n---> Reached the end of ${files[$i]}"
                read -p "Press [Enter] to flood the next older file (${files[$((i+1))]}), or type 'q' to quit: " choice
                if [[ "$choice" == "q" || "$choice" == "Q" ]]; then echo "Exiting..."; break; fi
            else
                echo -e "\n---> Reached the oldest saved ns.conf file."
            fi
        done
    else 
        find . -path "*/nsconfig/ns.conf*" -exec grep -HinE "$1" {} + 2>/dev/null
    fi 
}

# ADC/ADM: View ns.log interactively, or search if argument given
nslg() { 
    if [ -z "$1" ]; then 
        local files=( $(find . -path "*/var/log/ns.log*" | sort -V 2>/dev/null) )
        if [ ${#files[@]} -eq 0 ]; then echo "No ns.log files found."; return; fi
        
        for i in "${!files[@]}"; do
            echo -e "\n\e[1m==========================================================\e[0m"
            echo -e "\e[1m 📄 DUMPING: ${files[$i]} \e[0m"
            echo -e "\e[1m==========================================================\e[0m"
            sleep 1
            zcat -f "${files[$i]}"
            
            if [ $i -lt $(( ${#files[@]} - 1 )) ]; then
                echo -e "\n---> Reached the end of ${files[$i]}"
                read -p "Press [Enter] to flood the next older log (${files[$((i+1))]}), or type 'q' to quit: " choice
                if [[ "$choice" == "q" || "$choice" == "Q" ]]; then echo "Exiting..."; break; fi
            else
                echo -e "\n---> Reached the oldest ns.log file in bundle."
            fi
        done
    else 
        find . -path "*/var/log/ns.log*" -exec zgrep -HinE "$1" {} + 2>/dev/null
    fi 
}

